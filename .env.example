# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string
# Retrieve this from your Neon Console (postgresql://...)
DATABASE_URL=

# VAPID Keys for Web Push Notifications
# The Public Key is used on the client-side, so it must start with VITE_
VITE_VAPID_PUBLIC_KEY=
# The Private Key is secret and should ONLY be used on the server-side
VAPID_PRIVATE_KEY=

# Private access code for this single-user app. Required in production. Never VITE_.
APP_ACCESS_TOKEN=
# Independent random secrets (at least 32 bytes each). Vercel sends CRON_SECRET as Bearer.
CRON_SECRET=
REMINDER_ACTION_SECRET=
# Enable only after migration, scheduler and a single-device check are verified.
REMINDERS_ENABLED=false
VAPID_SUBJECT=mailto:contato@hagenda.app

